# Copy this file to .env and fill in real values before deploying.
# The server reads these with plain process.env - no extra package
# needed: `npm run server` / `npm start` already pass
# --env-file-if-exists=.env to node, which loads this file
# automatically if it exists and does nothing if it doesn't.

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the API server listens on. Most hosts (Railway, Render, etc.)
# set this for you automatically - only set it yourself for local
# development if you don't want the default (3001).
PORT=
