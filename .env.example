# Copy this file to .env and fill in real values before deploying.
# The server reads these with plain process.env - no extra package
# needed: `npm run server` / `npm start` already pass
# --env-file-if-exists=.env to node, which loads this file
# automatically if it exists and does nothing if it doesn't.

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the API server listens on. Most hosts (Railway, Render, etc.)
# set this for you automatically - only set it yourself for local
# development if you don't want the default (3001).
PORT=

# Without these two, the app still works fully - contacts, invoices,
# everything - except the customer-facing "Pay now" button, which shows
# a friendly "not set up yet" message instead of erroring.
#
# Get both from your Stripe dashboard (https://dashboard.stripe.com):
# STRIPE_SECRET_KEY is under Developers > API keys (use the test key,
# starting with sk_test_, until you're ready to take real payments -
# switch to the live sk_live_ key only once you've tested the whole
# flow end to end). STRIPE_WEBHOOK_SECRET comes from Developers >
# Webhooks > add an endpoint pointing at
# https://<your-deployed-domain>/api/stripe/webhook, listening for the
# checkout.session.completed event - Stripe shows you the signing
# secret (whsec_...) once that endpoint is created.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
